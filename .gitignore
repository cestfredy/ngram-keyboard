# Data: never commit raw or processed corpora (size + licenses)
**/data/raw/*
**/data/processed/*
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep

# Trained models stay out of git, except the two small web-demo models (see keyboard/README.md)
models/
!keyboard/models/
keyboard/models/*
!keyboard/models/ngram-light.ngm
!keyboard/models/ngram-standard.ngm

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
